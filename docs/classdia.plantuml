@startuml
title Janus — identity and application record relationship
class "Cognito user" as Cognito {
  +sub: string
  +email: string
}
class "Account DynamoDB record" as Account {
  +id: string = Cognito sub
  +data.email: string
  +data.subscriptions: list
}
class "Player DynamoDB record" as Player {
  +id: string = Cognito sub
  +data: JSON
}
Cognito "1" -- "0..1" Account: asynchronously provisioned
Cognito "1" -- "0..1" Player: subject-scoped
note bottom of Account
Account HTTP access is read-only.
end note
@enduml
